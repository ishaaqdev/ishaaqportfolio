---
// All data fetched client-side so heatmap is always up-to-date
---

<section id="github" class="w-full border-t border-outline-variant bg-surface">
  <div class="max-w-[1200px] mx-auto px-margin-mobile md:px-margin-desktop py-stack-lg md:py-[120px]">

    <div class="mb-12">
      <p class="font-[Poppins] text-xs uppercase tracking-widest text-secondary mb-3">Open Source</p>
      <h2 class="font-headline-lg text-headline-lg text-primary mb-6 uppercase tracking-tight">GitHub Activity</h2>
      <div class="w-16 h-2 bg-primary"></div>
    </div>

    <!-- Stats row (skeleton → replaced by JS) -->
    <div id="gh-stats" class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
      <div class="border border-outline-variant h-[88px] animate-pulse bg-surface-container"></div>
      <div class="border border-outline-variant h-[88px] animate-pulse bg-surface-container"></div>
      <div class="border border-outline-variant h-[88px] animate-pulse bg-surface-container"></div>
      <div class="border border-outline-variant h-[88px] animate-pulse bg-surface-container"></div>
    </div>

    <!-- Heatmap (skeleton → replaced by JS) -->
    <div class="border-2 border-primary overflow-hidden">
      <div class="p-6 overflow-x-auto">
        <div id="gh-heatmap">
          <div class="w-full h-[120px] animate-pulse bg-surface-container"></div>
        </div>
      </div>
      <div class="px-6 pb-5 flex items-center justify-end gap-1 text-on-surface-variant" style="font-size:11px;">
        <span>Less</span>
        <div id="gh-legend" class="flex gap-1 mx-2"></div>
        <span>More</span>
      </div>
    </div>

    <div class="mt-6">
      <a
        href="https://github.com/ishaaqdev"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-brutalist inline-flex items-center gap-2 px-5 py-2.5 font-[Poppins] text-xs uppercase tracking-widest text-primary"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
        View on GitHub
      </a>
    </div>
  </div>
</section>

<script>
(function () {
  const CELL = 12, GAP = 3;
  const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const DAYS   = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];

  function v(name) {
    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  }
  function rgb(name) { return `rgb(${v(name)})`; }

  const LEVEL_VARS = [
    '--clr-surface-container',
    '--clr-outline-variant',
    '--clr-outline',
    '--clr-secondary',
    '--clr-primary',
  ];
  function cellColor(level) { return rgb(LEVEL_VARS[Math.min(level, 4)]); }

  function toISO(d) { return d.toISOString().split('T')[0]; }

  async function init() {
    try {
      const ac = new AbortController();
      setTimeout(() => ac.abort(), 20000);

      const res = await fetch(
        'https://github-contributions-api.jogruber.de/v4/ishaaqdev?y=last',
        { signal: ac.signal }
      );
      if (!res.ok) throw new Error(String(res.status));
      const { contributions: cs } = await res.json();

      /* ── stats ─────────────────────────────────────────── */
      const total  = cs.reduce((s, c) => s + c.count, 0);
      const active = cs.filter(c => c.count > 0).length;

      let longestStreak = 0, run = 0;
      for (const c of cs) {
        run = c.count > 0 ? run + 1 : 0;
        if (run > longestStreak) longestStreak = run;
      }

      let curStreak = 0;
      for (let i = cs.length - 1; i >= 0; i--) {
        if (cs[i].count > 0) curStreak++;
        else if (curStreak > 0) break;
      }

      const SEP = rgb('--clr-outline-variant');
      const FG  = rgb('--clr-primary');
      const MUT = rgb('--clr-on-surface-variant');
      const BG  = rgb('--clr-surface');

      const statItems = [
        ['Contributions', total.toLocaleString()],
        ['Current Streak', `${curStreak}d`],
        ['Longest Streak', `${longestStreak}d`],
        ['Active Days', String(active)],
      ];
      document.getElementById('gh-stats').innerHTML = statItems
        .map(([lbl, val]) => `
          <div style="border:1px solid ${SEP};padding:16px 20px;background:${BG};">
            <div style="font-size:26px;font-weight:700;color:${FG};line-height:1;">${val}</div>
            <div style="font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:${MUT};margin-top:8px;">${lbl}</div>
          </div>`)
        .join('');

      /* ── build weekly buckets ──────────────────────────── */
      const map = {};
      cs.forEach(c => { map[c.date] = c; });

      const first = new Date(cs[0].date);
      const last  = new Date(cs[cs.length - 1].date);
      const start = new Date(first);
      start.setDate(start.getDate() - start.getDay()); // rewind to Sunday

      const weeks = [];
      let week = [];
      const iter = new Date(start);

      while (iter <= last) {
        const d = toISO(iter);
        const c = map[d];
        const inRange = iter >= first && iter <= last;
        week.push({ date: d, count: c?.count ?? 0, level: c?.level ?? 0, inRange });
        if (iter.getDay() === 6) { weeks.push(week); week = []; }
        iter.setDate(iter.getDate() + 1);
      }
      if (week.length) {
        while (week.length < 7) week.push({ date: '', count: 0, level: 0, inRange: false });
        weeks.push(week);
      }

      /* ── month label positions ─────────────────────────── */
      const mPos = [];
      let lastM = -1;
      weeks.forEach((wk, wi) => {
        if (!wk[0].date) return;
        const dt = new Date(wk[0].date);
        if (dt.getMonth() !== lastM && dt.getDate() <= 7) {
          mPos.push({ x: wi * (CELL + GAP), text: MONTHS[dt.getMonth()] });
          lastM = dt.getMonth();
        }
      });

      /* ── render SVG ────────────────────────────────────── */
      const DLW = 28, MH = 18;
      const W = DLW + weeks.length * (CELL + GAP);
      const H = MH + 7 * CELL + 6 * GAP;
      const DIM = rgb('--clr-on-surface-variant');

      let svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" style="display:block;overflow:visible;">`;

      mPos.forEach(({ x, text }) => {
        svg += `<text x="${DLW + x}" y="12" font-size="10" fill="${DIM}" font-family="system-ui,sans-serif">${text}</text>`;
      });

      [1, 3, 5].forEach(di => {
        const y = MH + di * (CELL + GAP) + CELL - 2;
        svg += `<text x="0" y="${y}" font-size="9" fill="${DIM}" font-family="system-ui,sans-serif">${DAYS[di].slice(0, 3)}</text>`;
      });

      weeks.forEach((wk, wi) => {
        wk.forEach((day, di) => {
          if (!day.inRange) return;
          const x = DLW + wi * (CELL + GAP);
          const y = MH + di * (CELL + GAP);
          const fill = cellColor(day.level);
          svg += `<rect x="${x}" y="${y}" width="${CELL}" height="${CELL}" rx="2" fill="${fill}">`;
          svg += `<title>${day.date}: ${day.count} contribution${day.count !== 1 ? 's' : ''}</title>`;
          svg += `</rect>`;
        });
      });

      svg += '</svg>';
      document.getElementById('gh-heatmap').innerHTML = svg;

      document.getElementById('gh-legend').innerHTML = [0, 1, 2, 3, 4]
        .map(l => `<div style="width:12px;height:12px;border-radius:2px;background:${cellColor(l)};flex-shrink:0;"></div>`)
        .join('');

    } catch (err) {
      const MUT = rgb('--clr-on-surface-variant');
      document.getElementById('gh-stats').innerHTML = `
        <div style="grid-column:span 4;padding:16px;text-align:center;color:${MUT};font-size:14px;">
          Could not load GitHub activity — visit
          <a href="https://github.com/ishaaqdev" style="text-decoration:underline;" target="_blank" rel="noopener">github.com/ishaaqdev</a>
        </div>`;
      document.getElementById('gh-heatmap').innerHTML = '';
    }
  }

  init();
})();
</script>
